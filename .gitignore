# Local secrets and environment overrides
**/.env
**/.env.*
!**/.env.example

# Python
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.coverage
**/htmlcov/

# Node / Next.js
**/node_modules/
**/.next/
**/out/
**/coverage/
**/*.tsbuildinfo
**/next-env.d.ts

# User materials and runtime output
**/uploads/
**/log/
**/logs/
**/*.log
**/script_status.json

# Local visual acceptance evidence; runtime assets belong under public/ instead
/zhihu/artifacts/

# Large or private database artifacts
*.sql.gz
*.dump
*.sqlite3
*.db

# Local repository-history archive used while consolidating the monorepo
/.legacy-git/

# OS / editors
.DS_Store
.idea/
.vscode/
