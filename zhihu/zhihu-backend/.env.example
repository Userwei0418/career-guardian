JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-dedicated-long-random-secret
