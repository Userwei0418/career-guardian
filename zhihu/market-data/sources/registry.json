    {
      "code": "picc-campus-public-api",
      "name": "中国人保官方校园招聘",
      "adapter_type": "api",
      "base_url": "https://picc.zhiye.com/api/Jobad/GetJobAdPageList",
      "allowed_hosts": ["picc.zhiye.com"],
      "config": {
        "method": "POST",
        "headers": {
          "Accept": "application/json, text/plain, */*",
          "Content-Type": "application/json",
          "Origin": "https://picc.zhiye.com",
          "Referer": "https://picc.zhiye.com/campus"
        },
        "success_path": "Code",
        "success_value": 200,
        "items_path": "Data",
        "id_field": "JobAdId",
        "published_field": "PostDate",
        "url_template": "https://picc.zhiye.com/campus/detail?jobAdId={id}",
        "pagination": {
          "mode": "json_body",
          "page_index_field": "PageIndex",
          "page_size_field": "PageSize",
          "start_page": 0,
          "page_size": 100,
          "total_path": "Count",
          "max_pages": 20
        },
        "promotion_mapping": {
          "company_name": {"literal": "中国人民保险集团股份有限公司"},
          "title": {"path": "JobAdName"},
          "city": {"path": "LocNames"},
          "location_text": {"path": "LocNames"},
          "department": {"path": "Org"},
          "description": {"path": "Duty"},
          "responsibilities": {"path": "Duty"},
          "requirements": {"path": "Require"},
          "education_requirement": {"path": "Degree"},
          "experience_requirement": {"path": "YearsOfWorking"},
          "job_category": {"paths": ["ClassificationTwo", "ClassificationOne", "Kind"]},
          "employment_type": {"literal": "校园招聘"},
          "is_campus": {"literal": true},
          "salary_text": {"path": "Salary"},
          "published_at": {"path": "PostDate"},
          "deadline_at": {"path": "EndTime"}
        },
        "json_body": {
          "Category": ["2"],
          "SpecialType": 0,
          "PageIndex": 0,
          "PageSize": 100,
          "DisplayFields": [
            "Id",
            "HeadCount",
            "JobAdId",
            "JobAdName",
            "Kind",
            "LocNames",
            "Org",
            "PostDate",
            "EndTime",
            "Salary",
            "ClassificationOne",
            "ClassificationTwo",
            "Duty",
            "Require",
            "Degree",
            "YearsOfWorking",
            "Category"
          ]
        }
      },
      "terms_review_status": "pending",
      "enabled": false,
      "min_interval_seconds": 1,
      "timeout_seconds": 20,
      "max_retries": 1
    },
