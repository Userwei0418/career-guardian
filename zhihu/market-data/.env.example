MARKET_STAGING_DATABASE_URL=mysql+pymysql://root:replace-me@127.0.0.1:3306/pin_legacy_staging
MARKET_RAW_DATABASE_URL=mysql+pymysql://root:replace-me@127.0.0.1:3306/market_raw
MARKET_CORE_DATABASE_URL=mysql+pymysql://root:replace-me@127.0.0.1:3306/zhihu

# 正式运行只读清洗后的 Core；fixture 与 SQLite 只用于自动化测试。
MARKET_PROVIDER=core
MARKET_FIXTURE_PATH=./fixtures/integrated_graduate_case.json
MARKET_API_PORT=8100

# 仅职护后端持有；用于调用市场采集管理接口，不能暴露给浏览器。
MARKET_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
MARKET_SOURCE_REGISTRY_PATH=./sources/registry.json

# 仅用于一次性的历史备份重放；日常初始化和新采集不读取旧项目。
PIN_LEGACY_IMPORT_APPROVED=false
