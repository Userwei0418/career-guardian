MARKET_STAGING_DATABASE_URL=sqlite:///./data/pin_legacy_staging.sqlite3
MARKET_RAW_DATABASE_URL=sqlite:///./data/market_raw.sqlite3
MARKET_CORE_DATABASE_URL=sqlite:///./data/market_core.sqlite3

# 默认显式使用脱敏集成样例；切换为 pin 时只读请求现有 Pin API。
MARKET_PROVIDER=fixture
MARKET_FIXTURE_PATH=./fixtures/integrated_graduate_case.json
PIN_API_BASE=http://127.0.0.1:8001
PIN_API_TIMEOUT_SECONDS=5
MARKET_API_PORT=8100

# 正式 Pin 备份迁移必须在人工确认后显式改为 true，并同时提供精确 SHA-256。
PIN_LEGACY_IMPORT_APPROVED=false
