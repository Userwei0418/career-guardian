        <mxCell id="interview_setup" value="&lt;div style=&quot;font-size:12px;color:#1D4ED8;letter-spacing:1px;&quot;&gt;约面后&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:600;margin-top:7px;&quot;&gt;面试官建面试&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-top:5px;&quot;&gt;系统生成追问清单并推送&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#3B82F6;fillColor=#EFF6FF;fontFamily=PingFang SC;fontSize=15;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_decision">
