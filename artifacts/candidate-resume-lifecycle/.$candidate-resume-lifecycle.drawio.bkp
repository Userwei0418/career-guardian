        <mxCell id="resume_ingest" value="&lt;div style=&quot;font-size:12px;color:#1D4ED8;letter-spacing:1px;&quot;&gt;统一入库&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:600;margin-top:7px;&quot;&gt;解析 · 去重 · 双源合并&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-top:6px;&quot;&gt;手机号 / 邮箱主键 → 人才档案&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#3B82F6;fillColor=#EFF6FF;fontFamily=PingFang SC;fontSize=15;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_governance">
