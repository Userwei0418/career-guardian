        <mxCell id="source_feishu" value="&lt;div style=&quot;font-size:12px;color:#1D4ED8;letter-spacing:1px;&quot;&gt;渠道 A · 飞书&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:600;margin-top:8px;&quot;&gt;新增投递事件&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#3B82F6;fillColor=#EFF6FF;fontFamily=PingFang SC;fontSize=15;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_intake">
          <mxGeometry x="30" y="135" width="250" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="source_boss" value="&lt;div style=&quot;font-size:12px;color:#C2410C;letter-spacing:1px;&quot;&gt;渠道 B · BOSS（同事 B）&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:600;margin-top:8px;&quot;&gt;打招呼 → 自动下载简历&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#9A3412;margin-top:5px;&quot;&gt;纯文本 · 独立数据源&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#F97316;fillColor=#FFF7ED;fontFamily=PingFang SC;fontSize=15;fontColor=#9A3412;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_intake">
          <mxGeometry x="30" y="350" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="intake_note" value="双源统一进入人才档案&lt;br&gt;BOSS 自动化不影响主系统" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;dashed=1;dashPattern=4 4;strokeWidth=1.5;strokeColor=#94A3B8;fillColor=#FFFFFF;fontFamily=PingFang SC;fontSize=12;fontColor=#64748B;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="stage_intake">
