        </mxCell>
        <mxCell id="hr_decision" value="&lt;div style=&quot;font-size:12px;color:#C2410C;letter-spacing:1px;&quot;&gt;HR 人工决定&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:600;margin-top:7px;&quot;&gt;约面 / 待定 / 不合适&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#9A3412;margin-top:6px;&quot;&gt;同步反馈岗位画像&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2.5;strokeColor=#F97316;fillColor=#FFF7ED;fontFamily=PingFang SC;fontSize=15;fontColor=#9A3412;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_decision">
