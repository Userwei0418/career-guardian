        </mxCell>
        <mxCell id="assessment_report" value="&lt;div style=&quot;font-size:12px;color:#15803D;letter-spacing:1px;&quot;&gt;多轮评估&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:600;margin-top:7px;&quot;&gt;汇总报告&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#166534;margin-top:5px;&quot;&gt;证据链 + 建议&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#22C55E;fillColor=#F0FDF4;fontFamily=PingFang SC;fontSize=15;fontColor=#14532D;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_decision">
