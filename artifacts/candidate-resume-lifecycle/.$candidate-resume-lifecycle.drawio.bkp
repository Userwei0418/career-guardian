        <mxCell id="ai_match" value="&lt;div style=&quot;font-size:12px;color:#15803D;letter-spacing:1px;&quot;&gt;AI 匹配打分&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:600;margin-top:7px;&quot;&gt;简历文本 × 岗位画像&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#166534;margin-top:6px;&quot;&gt;维度评分 · 原文证据 · 存疑点&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#22C55E;fillColor=#F0FDF4;fontFamily=PingFang SC;fontSize=15;fontColor=#14532D;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_screening">
