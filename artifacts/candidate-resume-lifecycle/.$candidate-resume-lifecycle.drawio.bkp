        </mxCell>
        <mxCell id="screening_conclusion" value="&lt;div style=&quot;font-size:12px;color:#1D4ED8;letter-spacing:1px;&quot;&gt;推送筛选结论&lt;/div&gt;&lt;div style=&quot;font-size:17px;font-weight:600;margin-top:7px;&quot;&gt;强匹配 / 中匹配 / 弱匹配&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-top:6px;&quot;&gt;前端 + 飞书机器人卡片&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#3B82F6;fillColor=#EFF6FF;fontFamily=PingFang SC;fontSize=15;fontColor=#1E3A8A;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_screening">
