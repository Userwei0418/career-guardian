        <mxCell id="stage_screening" value="03  智能筛选" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;arcSize=10;collapsible=0;strokeWidth=1.5;strokeColor=#CBD5E1;fillColor=#F8FAFC;swimlaneFillColor=#FFFFFF;fontFamily=PingFang SC;fontSize=15;fontStyle=1;fontColor=#334155;align=left;spacingLeft=18;" vertex="1" parent="1">
