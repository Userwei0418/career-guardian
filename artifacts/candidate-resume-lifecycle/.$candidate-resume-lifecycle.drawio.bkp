        <mxCell id="talent_pool" value="&lt;div style=&quot;font-size:12px;color:#64748B;letter-spacing:1px;&quot;&gt;人才库归档&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:600;margin-top:7px;&quot;&gt;不自动拒绝&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#64748B;margin-top:5px;&quot;&gt;保留状态与证据&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.8;strokeColor=#94A3B8;fillColor=#F8FAFC;fontFamily=PingFang SC;fontSize=15;fontColor=#334155;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=14;" vertex="1" parent="stage_decision">
          <mxGeometry x="35" y="585" width="230" height="105" as="geometry"/>
